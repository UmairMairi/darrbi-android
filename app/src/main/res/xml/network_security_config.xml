<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Secure by default (preprod/production are HTTPS). -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Dev/UAT backends are served over plain HTTP, so permit cleartext for just those hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">150.230.54.239</domain>
        <domain includeSubdomains="true">api-darbi.xintdev.com</domain>
        <domain includeSubdomains="true">admin-darbi.xintdev.com</domain>
        <domain includeSubdomains="true">dev-dashboard.ride.sa</domain>
        <domain includeSubdomains="true">ride-aride.xintdev.com</domain>
    </domain-config>
</network-security-config>
